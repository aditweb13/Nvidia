# Nebius Token Factory API Configuration
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.ai/v1
TOKEN_FACTORY_API_KEY=your_token_factory_api_key_here

# Nemotron Model IDs (check Token Factory catalog)
MODEL_NANO=nvidia/nemotron-nano-9b-instruct
MODEL_SUPER=nvidia/nemotron-super-49b-instruct
MODEL_ULTRA=nvidia/nemotron-ultra-340b-instruct

# Model Pricing in USD per 1M tokens (from Token Factory pricing)
PRICE_NANO_IN=0.10
PRICE_NANO_OUT=0.20
PRICE_SUPER_IN=0.50
PRICE_SUPER_OUT=1.50
PRICE_ULTRA_IN=2.00
PRICE_ULTRA_OUT=6.00

# Database
DB_PATH=data/cascade.db

# Optional Feature Flags
ENABLE_CONSISTENCY_VERIFIER=false
ENABLE_JUDGE_VERIFIER=false
RESPONSE_CACHE_ENABLED=true
